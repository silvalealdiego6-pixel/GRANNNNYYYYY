    pinkKeyObj = scene.physics.add.sprite(1150, 350, 'pink_key');

    // SALA DE ESTAR
    for(let x=1400; x<1800; x+=20) walls.create(x, 400, 'wall');
    for(let y=200; y<400; y+=20) walls.create(1800, y, 'wall');
    scene.add.text(1500, 220, 'SALA DE ESTAR', { font: '13px sans-serif', fill: '#aaffaa' });
    hornObj = scene.physics.add.sprite(1600, 300, 'horn');

    // CORREDOR
    for(let y=400; y<500; y+=20) walls.create(900, y, 'wall');
    for(let y=400; y<500; y+=20) walls.create(1100, y, 'wall');
    scene.add.text(950, 430, 'CORREDOR', { font: '12px sans-serif', fill: '#888' });
    headlightObj = scene.physics.add.sprite(1000, 450, 'headlight');

    // OFICINA
    for(let x=1100; x<1600; x+=20) walls.create(x, 700, 'wall');
    for(let y=500; y<700; y+=20) walls.create(1600, y, 'wall');
    for(let y=500; y<540; y+=20) walls.create(1100, y, 'wall');
    for(let y=640; y<700; y+=20) walls.create(1100, y, 'wall');
    scene.add.text(1200, 530, 'OFICINA', { font: '14px sans-serif', fill: '#ffcc00' });
    alternatorObj = scene.physics.add.sprite(1300, 600, 'alternator');
    beltObj = scene.physics.add.sprite(1450, 650, 'belt');
    filterObj = scene.physics.add.sprite(1250, 550, 'filter');

    // JARDIM INTERNO - ENTRADA ABERTA
    for(let x=1600; x<2100; x+=20) walls.create(x, 500, 'wall');
    for(let x=1600; x<2100; x+=20) walls.create(x, 700, 'wall');
    for(let y=500; y<700; y+=20) walls.create(2100, y, 'wall');
    walls.create(1600, 500, 'wall');
    walls.create(1600, 520, 'wall');
    walls.create(1600, 680, 'wall');
    walls.create(1600, 700, 'wall');

    scene.add.text(1700, 530, 'JARDIM INTERNO', { font: '13px sans-serif', fill: '#66ff66' });
    exhaustObj = scene.physics.add.sprite(1750, 600, 'exhaust');
    pumpObj = scene.physics.add.sprite(1900, 580, 'pump');

    // PORÃO SECRETO
    for(let x=1000; x<1500; x+=20) walls.create(x, 1600, 'wall');
    for(let y=1200; y<1600; y+=20) walls.create(1000, y, 'wall');
    for(let y=1200; y<1600; y+=20) walls.create(1500, y, 'wall');
    scene.add.text(1100, 1250, 'PORÃO SECRETO', { font: '13px sans-serif', fill: '#ff6666' });
    radiatorObj = scene.physics.add.sprite(1200, 1400, 'radiator');
    cyanKeyObj = scene.physics.add.sprite(1350, 1450, 'cyan_key');

    // QUARTO DE HÓSPEDES
    for(let y=820; y<900; y+=20) walls.create(1600, y, 'wall');
    for(let y=820; y<900; y+=20) walls.create(2100, y, 'wall');
    for(let x=1600; x<1720; x+=20) walls.create(x, 900, 'wall');
    for(let x=1840; x<2100; x+=20) walls.create(x, 900, 'wall');
    pinkDoorObj = scene.physics.add.staticSprite(1780, 900, 'pink_door');
    scene.add.text(1680, 850, 'QUARTO HÓSPEDES', { font: '12px sans-serif', fill: '#ff99cc' });
    cableObj = scene.physics.add.sprite(1800, 950, 'cable');

    // DESPENSA
    for(let y=1600; y<1700; y+=20) walls.create(300, y, 'wall');
    for(let y=1600; y<1700; y+=20) walls.create(700, y, 'wall');
    for(let x=300; x<420; x+=20) walls.create(x, 1700, 'wall');
    for(let x=540; x<700; x+=20) walls.create(x, 1700, 'wall');
    cyanDoorObj = scene.physics.add.staticSprite(480, 1700, 'cyan_door');
    scene.add.text(380, 1650, 'DESPENSA', { font: '13px sans-serif', fill: '#00ccff' });
    fuseObj = scene.physics.add.sprite(500, 1800, 'fuse');

    // Player
    players[myPlayerId] = scene.physics.add.sprite(80, 80, 'player_base');
    players[myPlayerId].setTint(myColor);
    scene.physics.add.collider(players[myPlayerId], walls);
    this.cameras.main.startFollow(players[myPlayerId], true, 0.08, 0.08);

    // Teclado
    cursors = this.input.keyboard.createCursorKeys();
    wasd = this.input.keyboard.addKeys({
        up: Phaser.Input.Keyboard.KeyCodes.W,
        down: Phaser.Input.Keyboard.KeyCodes.S,
        left: Phaser.Input.Keyboard.KeyCodes.A,
        right: Phaser.Input.Keyboard.KeyCodes.D
    });

    aiGranny = scene.physics.add.sprite(650, 650, 'granny_sprite');
    scene.physics.add.collider(aiGranny, walls);
    lastGrannyPos = {x: aiGranny.x, y: aiGranny.y};

    setupInteractions();
    setupMobileControls();
}

function createOtherPlayer(id, color) {
    players[id] = scene.physics.add.sprite(80, 80, 'player_base');
    if (color) players[id].setTint(color);
}

function setupInteractions() {
    const keys = [
        {obj: redKeyObj, name: 'red'}, {obj: yellowKeyObj, name: 'yellow'},
        {obj: blueKeyObj, name: 'blue'}, {obj: greenKeyObj, name: 'green'},
        {obj: purpleKeyObj, name: 'purple'}, {obj: orangeKeyObj, name: 'orange'},
        {obj: pinkKeyObj, name: 'pink'}, {obj: cyanKeyObj, name: 'cyan'}
    ];
    keys.forEach(k => {
        if (k.obj) {
            scene.physics.add.overlap(players[myPlayerId], k.obj, () => {
                handleGameEvents('collect_key', k.name);
                sendNetAction('collect_key', k.name);
            });
        }
    });

    const doors = [
        {obj: redDoorObj, name: 'red'}, {obj: yellowDoorObj, name: 'yellow'},
        {obj: blueDoorObj, name: 'blue'}, {obj: greenDoorObj, name: 'green'},
        {obj: purpleDoorObj, name: 'purple'}, {obj: orangeDoorObj, name: 'orange'},
        {obj: pinkDoorObj, name: 'pink'}, {obj: cyanDoorObj, name: 'cyan'}
    ];
    doors.forEach(d => {
        if (d.obj) {
            scene.physics.add.collider(players[myPlayerId], d.obj, () => {
                if (gameKeys[d.name]) {
                    handleGameEvents('open_door', d.name);
                    sendNetAction('open_door', d.name);
                }
            });
        }
    });

    const parts = [
        {obj: engineObj, key: 'engine'}, {obj: gasObj, key: 'gas'}, {obj: tireObj, key: 'tire'},
        {obj: batteryObj, key: 'battery'}, {obj: sparkPlugObj, key: 'sparkPlug'}, {obj: carKeyObj, key: 'carKey'},
        {obj: radiatorObj, key: 'radiator'}, {obj: alternatorObj, key: 'alternator'}, {obj: oilObj, key: 'oil'},
        {obj: mirrorObj, key: 'mirror'}, {obj: seatObj, key: 'seat'}, {obj: exhaustObj, key: 'exhaust'},
        {obj: headlightObj, key: 'headlight'}, {obj: hornObj, key: 'horn'}, {obj: radioObj, key: 'radio'},
        {obj: beltObj, key: 'belt'}, {obj: filterObj, key: 'filter'}, {obj: pumpObj, key: 'pump'},
        {obj: cableObj, key: 'cable'}, {obj: fuseObj, key: 'fuse'}
    ];
    parts.forEach(p => {
        if (p.obj) {
            scene.physics.add.overlap(players[myPlayerId], p.obj, () => {
                carParts[p.key] = true;
                if (p.obj) p.obj.destroy();
                updateHUD();
            });
        }
    });

    scene.physics.add.collider(players[myPlayerId], carObj, () => {
        let allParts = Object.values(carParts).every(v => v === true);
        if (allParts) {
            alert("SENSACIONAL! VOCÊS ENCONTRARAM TODAS AS 20 PEÇAS E FUGIRAM COM O CARRO!");
            location.reload();
        } else {
            let missing = Object.values(carParts).filter(v => !v).length;
            alert(`Ainda faltam ${missing} peças!`);
        }
    });

    scene.physics.add.overlap(players[myPlayerId], shotgunObj, () => {
        if (!hasShotgun) {
            hasShotgun = true;
            if (shotgunObj) shotgunObj.destroy();
            document.getElementById('btn-shoot').style.display = 'block';
            updateHUD();
        }
    });

    scene.physics.add.overlap(players[myPlayerId], stairsToBasement, () => teleportPlayer(850, 950));
    scene.physics.add.overlap(players[myPlayerId], stairsToGarage, () => teleportPlayer(850, 650));
}

function teleportPlayer(x, y) {
    scene.cameras.main.fadeOut(300, 0, 0, 0);
    scene.cameras.main.once('camerafadeoutcomplete', () => {
        players[myPlayerId].setPosition(x, y);
        scene.cameras.main.fadeIn(300, 0, 0, 0);
    });
}

function shootGun() {
    if (!hasShotgun || shotgunAmmo <= 0) return;
    shotgunAmmo = 0;
    document.getElementById('btn-shoot').style.display = 'none';
    updateHUD();

    if (aiGranny && !isGrannyStunned) {
        let dist = Phaser.Math.Distance.Between(players[myPlayerId].x, players[myPlayerId].y, aiGranny.x, aiGranny.y);
        if (dist < 220) {
            isGrannyStunned = true;
            alert("Tiro certeiro! A Véia desmaiou por 1 minuto!");
            setTimeout(() => { isGrannyStunned = false; }, 60000);
        }
    }
}

function updateHUD() {
    let k = [];
    if (gameKeys.red) k.push("Vermelha");
    if (gameKeys.yellow) k.push("Amarela");
    if (gameKeys.blue) k.push("Azul");
    if (gameKeys.green) k.push("Verde");
    if (gameKeys.purple) k.push("Roxa");
    if (gameKeys.orange) k.push("Laranja");
    if (gameKeys.pink) k.push("Rosa");
    if (gameKeys.cyan) k.push("Ciano");
    document.getElementById('keys-list').innerText = k.length > 0 ? k.join(", ") : "Nenhuma";
    
    let parts = Object.values(carParts).filter(v => v).length;
    document.getElementById('car-parts').innerText = parts + "/20";
    document.getElementById('gun-status').innerText = hasShotgun ? (shotgunAmmo > 0 ? "Pronta (1 Tiro)" : "Vazia") : "Não";
}

function updateGrannyAI() {
    if (!aiGranny || isGrannyStunned || !players[myPlayerId]) return;

    let p = players[myPlayerId];
    let dist = Phaser.Math.Distance.Between(p.x, p.y, aiGranny.x, aiGranny.y);

    let moved = Phaser.Math.Distance.Between(aiGranny.x, aiGranny.y, lastGrannyPos.x, lastGrannyPos.y);
    if (moved < 2) grannyStuckTimer++;
    else grannyStuckTimer = 0;
    lastGrannyPos = {x: aiGranny.x, y: aiGranny.y};

    if (dist < 380) {
        grannyState = 'chase';
        scene.physics.moveToObject(aiGranny, p, 115);

        if (grannyStuckTimer > 40) {
            let angle = Phaser.Math.Angle.Between(aiGranny.x, aiGranny.y, p.x, p.y);
            let offset = (Math.random() > 0.5 ? 1 : -1) * 1.2;
            aiGranny.setVelocity(Math.cos(angle + offset) * 120, Math.sin(angle + offset) * 120);
            grannyStuckTimer = 0;
        }
    } else {
        grannyState = 'patrol';
        let target = patrolPoints[currentPatrolIndex];
        let distToTarget = Phaser.Math.Distance.Between(aiGranny.x, aiGranny.y, target.x, target.y);

        if (distToTarget < 40) {
            currentPatrolIndex = (currentPatrolIndex + 1) % patrolPoints.length;
        } else {
            scene.physics.moveTo(aiGranny, target.x, target.y, 90);
        }

        if (grannyStuckTimer > 60) {
            currentPatrolIndex = (currentPatrolIndex + 1) % patrolPoints.length;
            grannyStuckTimer = 0;
        }
    }

    if (dist < 24) {
        p.setPosition(80, 80);
    }
}

function update() {
    if (isPaused) return;
    let p = players[myPlayerId];
    if (!p) return;

    let speed = 145;
    p.setVelocity(0);

    // Controles de teclado (PC)
    let moveX = 0;
    let moveY = 0;

    if (cursors.left.isDown || wasd.left.isDown) moveX = -1;
    else if (cursors.right.isDown || wasd.right.isDown) moveX = 1;

    if (cursors.up.isDown || wasd.up.isDown) moveY = -1;
    else if (cursors.down.isDown || wasd.down.isDown) moveY = 1;

    // Controles de toque (Mobile)
    if (touchInput.x !== 0 || touchInput.y !== 0) {
        moveX = touchInput.x;
        moveY = touchInput.y;
    }

    if (moveX !== 0 || moveY !== 0) {
        p.setVelocityX(moveX * speed);
        p.setVelocityY(moveY * speed);
        sendNetPosition();
    }

    updateGrannyAI();
}

function setupMobileControls() {
    const bindBtn = (id, x, y) => {
        const el = document.getElementById(id);
        const start = (e) => { e.preventDefault(); touchInput.x = x; touchInput.y = y; };
        const end = (e) => { e.preventDefault(); touchInput.x = 0; touchInput.y = 0; };
        el.addEventListener('touchstart', start); el.addEventListener('touchend', end);
        el.addEventListener('mousedown', start); el.addEventListener('mouseup', end);
        el.addEventListener('mouseleave', end);
    };
    bindBtn('btn-left', -1, 0);
    bindBtn('btn-right', 1, 0);
    bindBtn('btn-up', 0, -1);
    bindBtn('btn-down', 0, 1);
}
</script>
</body>
